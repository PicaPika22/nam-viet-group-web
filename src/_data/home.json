    {
      "id": "about",
      "visible": true,
      "order": 2,
      "content": {
        "en": {
          "chapterLabel": "WHO WE ARE",
          "eyebrow": "Who We Are",
          "titleLine1": "Built on Experience.",
          "titleLine2": "Driven by Innovation.",
          "lead": "For over 20 years, Nam Viet Group has driven sustainable growth across Vietnam's agribusiness sector through innovation, quality manufacturing and long-term partnerships.",
          "body": "From feed production to logistics, ports and strategic investments, we continuously expand our integrated ecosystem to deliver greater value for customers, partners and future generations."
        },
        "vi": {
          "chapterLabel": "VỀ CHÚNG TÔI",
          "eyebrow": "Về chúng tôi",
          "titleLine1": "Xây dựng từ kinh nghiệm.",
          "titleLine2": "Tiến bằng đổi mới.",
          "lead": "Trong hơn hai thập kỷ, Tập đoàn Nam Việt kiên định theo đuổi tăng trưởng bền vững trong lĩnh vực nông nghiệp Việt Nam thông qua đổi mới, sản xuất chất lượng cao và quan hệ hợp tác lâu dài.",
          "body": "Từ sản xuất thức ăn chăn nuôi đến logistics, kho cảng và đầu tư chiến lược, chúng tôi không ngừng mở rộng hệ sinh thái tích hợp để mang lại nhiều giá trị hơn cho khách hàng, đối tác và cộng đồng."
        },
        "zh": {
          "chapterLabel": "关于我们",
          "eyebrow": "关于我们",
          "titleLine1": "根植经验。",
          "titleLine2": "创新驱动未来。",
          "lead": "二十余年来，南越集团坚持以创新科技、优质制造与长期合作伙伴关系，推动越南农业产业实现可持续增长。",
          "body": "从饲料生产、物流仓储、港口运营到战略投资，我们持续拓展一体化产业生态，为客户、合作伙伴与社会创造更大价值。"
        }
      },
