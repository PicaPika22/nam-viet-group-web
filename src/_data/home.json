      "content": {
        "en": {
          "chapterLabel": "INTRO",
          "eyebrow": "Nam Viet Group",
          "titleLine1": "Feeding Growth.",
          "titleLine2": "Connecting the Future.",
          "lead": "For more than two decades, Nam Viet Group has built an integrated agribusiness ecosystem — connecting feed manufacturing, logistics, port infrastructure and global partnerships to deliver sustainable value across every stage of the supply chain.",
          "ctaPrimary": "Explore Our Journey",
          "ctaSecondary": "Explore the ecosystem",
          "scroll": "Scroll to explore"
        },
        "vi": {
          "chapterLabel": "MỞ ĐẦU",
          "eyebrow": "Tập đoàn Nam Việt",
          "titleLine1": "Nuôi dưỡng tăng trưởng.",
          "titleLine2": "Kết nối tương lai.",
          "lead": "Hơn hai thập kỷ xây dựng hệ sinh thái nông nghiệp tích hợp, Tập đoàn Nam Việt kết nối sản xuất thức ăn chăn nuôi, logistics, kho cảng và mạng lưới đối tác toàn cầu — kiến tạo giá trị bền vững xuyên suốt chuỗi cung ứng.",
          "ctaPrimary": "Khám phá hành trình",
          "ctaSecondary": "Khám phá hệ sinh thái",
          "scroll": "Cuộn để khám phá"
        },
        "zh": {
          "chapterLabel": "开篇",
          "eyebrow": "南越集团",
          "titleLine1": "滋养增长。",
          "titleLine2": "连接未来。",
          "lead": "二十余年深耕越南农业产业链，南越集团打造涵盖饲料生产、物流仓储、港口基础设施与全球战略伙伴的一体化生态系统——在供应链每一环节创造可持续价值。",
          "ctaPrimary": "探索我们的旅程",
          "ctaSecondary": "探索生态体系",
          "scroll": "向下滚动探索"
        }
      },
