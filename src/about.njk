          <span class="lang en"><span data-count="542">0</span>B+</span></span>
          <span class="lang vi"><span data-count="542">0</span> tỷ</span></span>
          <span class="lang zh"><span data-count="542">0</span>B+</span></span>
        </span>
        <span class="stat__label">
          <span class="lang en">VND charter capital</span>
