        <span class="lang en">{{ i18n.en.breadcrumbHome }}</span>
        <span class="lang vi">{{ i18n.vi.breadcrumbHome }}</span>
        <span class="lang zh">{{ i18n.zh.breadcrumbHome }}</span>
      </a>
      <span aria-hidden="true">/</span>
      <span>
        <span class="lang en">About</span>
        <span class="lang vi">Giới thiệu</span>
        <span class="lang zh">关于</span>
      </span>
    </nav>
    <header class="chapter__head">
      <p class="eyebrow eyebrow--light reveal">
        <span class="lang en">About the Group</span>
        <span class="lang vi">Giới thiệu Tập đoàn</span>
        <span class="lang zh">关于集团</span>
      </p>
      <h1 class="chapter__title">
        <span class="lang en">
          <span class="line-mask"><span class="line">Nam Viet Group</span></span>
          <span class="line-mask"><span class="line line--accent">An integrated agribusiness ecosystem.</span></span>
        </span>
        <span class="lang vi">
          <span class="line-mask"><span class="line">Tập đoàn Nam Việt</span></span>
          <span class="line-mask"><span class="line line--accent">Hệ sinh thái nông nghiệp tích hợp.</span></span>
        </span>
        <span class="lang zh">
          <span class="line-mask"><span class="line">南越集团</span></span>
          <span class="line-mask"><span class="line line--accent">一体化农业产业生态。</span></span>
        </span>
      </h1>
      <p class="chapter__desc reveal" data-delay="200">
        <span class="lang en">We connect feed manufacturing, trading, logistics and ports so partners get reliable nutrition and supply across Vietnam and beyond.</span>
        <span class="lang vi">Chúng tôi kết nối sản xuất thức ăn, thương mại, logistics và kho cảng — mang dinh dưỡng và chuỗi cung ứng ổn định cho đối tác trong và ngoài nước.</span>
        <span class="lang zh">我们连接饲料制造、贸易、物流与港口，为境内外伙伴提供可靠的营养方案与供应链。</span>
      </p>
    </header>
  </div>
</section>

