    <img src="{{ '/assets/img/about.png' | url }}" alt="" width="1920" height="1080" decoding="async" fetchpriority="high">
    <div class="chapter__bg-veil chapter__bg-veil--strong"></div>
  </div>
  <div class="container about-hero__content">
    <nav class="breadcrumb about-hero__crumb reveal" aria-label="Breadcrumb">
