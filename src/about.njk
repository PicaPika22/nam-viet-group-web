---
layout: layouts/about.njk
title: About
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ localeUrl('/about/', locale) }}"
---

<section class="chapter chapter--dark about-hero about-hero--bleed" data-chapter="01" data-label-en="ABOUT" data-label-zh="关于" data-label-vi="GIỚI THIỆU">
  <div class="chapter__bg" data-parallax="0.12">
    <img src="{{ '/assets/img/about.png' | url }}" alt="" width="1920" height="1080" decoding="async" fetchpriority="high">
    <div class="chapter__bg-veil chapter__bg-veil--strong"></div>
  </div>
  <div class="container about-hero__content">
    <nav class="breadcrumb about-hero__crumb reveal" aria-label="Breadcrumb">
      <a href="{{ '/'  | localeUrl(locale) | url }}">
        {{ i18n[locale].breadcrumbHome }}
      </a>
      <span aria-hidden="true">/</span>
      <span>
        {{ ({ en: 'About', vi: 'Giới thiệu', zh: '关于' })[locale] }}
      </span>
    </nav>
    <header class="chapter__head">
      <p class="eyebrow eyebrow--light reveal">
        {{ ({ en: 'About the Group', vi: 'Giới thiệu Tập đoàn', zh: '关于集团' })[locale] }}
      </p>
      <h1 class="chapter__title">
        {% if locale == 'en' %}
          <span class="line-mask"><span class="line">Nam Viet Group</span></span>
          <span class="line-mask"><span class="line line--accent">An integrated agribusiness ecosystem.</span></span>
        {% elif locale == 'zh' %}
          <span class="line-mask"><span class="line">南越集团</span></span>
          <span class="line-mask"><span class="line line--accent">一体化农业产业生态。</span></span>
        {% else %}
          <span class="line-mask"><span class="line">Tập đoàn Nam Việt</span></span>
          <span class="line-mask"><span class="line line--accent">Hệ sinh thái nông nghiệp tích hợp.</span></span>
        {% endif %}
      </h1>
      <p class="chapter__desc reveal" data-delay="200">
        {{ ({ en: 'We connect feed manufacturing, trading, logistics and ports so partners get reliable nutrition and supply across Vietnam and beyond.', vi: 'Chúng tôi kết nối sản xuất thức ăn, thương mại, logistics và kho cảng — mang dinh dưỡng và chuỗi cung ứng ổn định cho đối tác trong và ngoài nước.', zh: '我们连接饲料制造、贸易、物流与港口，为境内外伙伴提供可靠的营养方案与供应链。' })[locale] }}
      </p>
    </header>
  </div>
</section>

<nav class="page-subnav about-subnav" aria-label="About sections" data-page-subnav>
  <div class="container page-subnav__inner">
    <a href="#overview" class="page-subnav__link is-active" data-subnav-target="overview">
      {{ ({ en: 'Overview', vi: 'Tổng quan', zh: '概览' })[locale] }}
    </a>
    <a href="#ecosystem" class="page-subnav__link" data-subnav-target="ecosystem">
      {{ ({ en: 'Ecosystem', vi: 'Hệ sinh thái', zh: '生态系统' })[locale] }}
    </a>
    <a href="#vision" class="page-subnav__link" data-subnav-target="vision">
      {{ ({ en: 'Direction', vi: 'Định hướng', zh: '方向' })[locale] }}
    </a>
    <a href="#leadership" class="page-subnav__link" data-subnav-target="leadership">
      {{ ({ en: 'Leadership', vi: 'Lãnh đạo', zh: '领导团队' })[locale] }}
    </a>
  </div>
</nav>

<section class="chapter chapter--light about-section" id="overview" data-page-panel="overview" data-chapter="01" data-label-en="OVERVIEW" data-label-zh="概览" data-label-vi="TỔNG QUAN">
  <div class="container">
    <header class="chapter__head about-section__head">
      <span class="chapter__num reveal">01</span>
      <p class="eyebrow reveal">
        {{ ({ en: 'Overview', vi: 'Tổng quan', zh: '概览' })[locale] }}
      </p>
      <h2 class="chapter__title chapter__title--sm">
        {% if locale == 'en' %}
          <span class="line-mask"><span class="line">Who we are</span></span>
          <span class="line-mask"><span class="line line--muted">in numbers that matter.</span></span>
        {% elif locale == 'zh' %}
          <span class="line-mask"><span class="line">我们是谁</span></span>
          <span class="line-mask"><span class="line line--muted">用关键指标说明。</span></span>
        {% else %}
          <span class="line-mask"><span class="line">Chúng tôi là ai</span></span>
          <span class="line-mask"><span class="line line--muted">qua những chỉ số then chốt.</span></span>
        {% endif %}
      </h2>
      <p class="chapter__desc reveal" data-delay="150">
        {{ ({ en: 'From feed production to logistics, ports and strategic investments, we expand one ecosystem for customers, partners and communities.', vi: 'Từ thức ăn chăn nuôi đến logistics, kho cảng và đầu tư chiến lược, chúng tôi mở rộng một hệ sinh thái phục vụ khách hàng, đối tác và xã hội.', zh: '从饲料生产到物流、港口与战略投资，我们拓展同一生态系统，服务客户、伙伴与社区。' })[locale] }}
      </p>
    </header>

    <div class="stats about-stats reveal">
      <div class="stat" data-delay="0">
        <span class="stat__value"><span data-count="25">0</span>+</span>
        <span class="stat__label">
          {{ ({ en: 'Years building the Group', vi: 'Năm hình thành &amp; phát triển', zh: '年集团发展历程' })[locale] }}
        </span>
      </div>
      <div class="stat" data-delay="80">
        <span class="stat__value"><span data-count="10">0</span></span>
        <span class="stat__label">
          {{ ({ en: 'Units in the ecosystem', vi: 'Đơn vị trong hệ sinh thái', zh: '生态体系内企业单位' })[locale] }}
        </span>
      </div>
      <div class="stat" data-delay="160">
        <span class="stat__value"><span data-count="186">0</span>+</span>
        <span class="stat__label">
          {{ ({ en: 'Projects delivered', vi: 'Dự án đã triển khai', zh: '已交付项目' })[locale] }}
        </span>
      </div>
      <div class="stat" data-delay="240">
        <span class="stat__value">
          <span data-count="542">0</span>{% if locale == 'vi' %} tỷ{% else %}B+{% endif %}
        </span>
        <span class="stat__label">
          {{ ({ en: 'VND charter capital', vi: 'Vốn điều lệ (đồng)', zh: '注册资本（越南盾）' })[locale] }}
        </span>
      </div>
    </div>

    <aside class="about-capacity" aria-label="Production capacity">
      <p class="about-capacity__label reveal">
        {{ ({ en: 'Feed production capacity', vi: 'Năng lực sản xuất thức ăn', zh: '饲料产能' })[locale] }}
      </p>
      <div class="about-capacity__grid">
        <div class="about-capacity__item reveal">
          <span class="about-capacity__value"><span data-count="300000">0</span></span>
          <span class="about-capacity__unit">
            {{ about.capacity.poultryLine.unit[locale] }}
          </span>
          <p class="about-capacity__note">
            {{ about.capacity.poultryLine.label[locale] }}
          </p>
        </div>
        <div class="about-capacity__item reveal" data-delay="100">
          <span class="about-capacity__value"><span data-count="10">0</span></span>
          <span class="about-capacity__unit">
            {{ about.capacity.aquaLine.unit[locale] }}
          </span>
          <p class="about-capacity__note">
            {{ about.capacity.aquaLine.label[locale] }}
          </p>
        </div>
      </div>
    </aside>
  </div>
</section>

{% if ecosystem and ecosystem.sectors and ecosystem.sectors.length %}
<section class="chapter chapter--light about-section about-ecosystem" id="ecosystem" data-page-panel="ecosystem" data-chapter="02" data-label-en="ECOSYSTEM" data-label-zh="生态系统" data-label-vi="HỆ SINH THÁI">
  <div class="container">
    <header class="chapter__head about-section__head">
      <span class="chapter__num reveal">02</span>
      <p class="eyebrow reveal">
        {{ ({ en: 'Ecosystem', vi: 'Hệ sinh thái', zh: '生态系统' })[locale] }}
      </p>
      <h2 class="chapter__title chapter__title--sm">
        {% if locale == 'en' %}
          <span class="line-mask"><span class="line">One value chain.</span></span>
          <span class="line-mask"><span class="line line--muted">Member companies by sector.</span></span>
        {% elif locale == 'zh' %}
          <span class="line-mask"><span class="line">一条价值链。</span></span>
          <span class="line-mask"><span class="line line--muted">按领域划分的成员企业。</span></span>
        {% else %}
          <span class="line-mask"><span class="line">Một chuỗi giá trị.</span></span>
          <span class="line-mask"><span class="line line--muted">Công ty thành viên theo lĩnh vực.</span></span>
        {% endif %}
      </h2>
      <p class="chapter__desc reveal" data-delay="150">
        {{ ecosystem.intro[locale] }}
      </p>
    </header>

    <div class="about-chain-wrap reveal">
      <p class="about-chain__label">
        {{ ({ en: 'Integrated value chain', vi: 'Chuỗi giá trị tích hợp', zh: '一体化价值链' })[locale] }}
      </p>
      <ol class="about-chain" aria-label="Value chain">
        <li>{{ ({ en: 'Raw materials', vi: 'Nguyên liệu', zh: '原材料' })[locale] }}</li>
        <li>{{ ({ en: 'R&amp;D', vi: 'R&amp;D', zh: '研发' })[locale] }}</li>
        <li>{{ ({ en: 'Manufacturing', vi: 'Sản xuất', zh: '制造' })[locale] }}</li>
        <li>{{ ({ en: 'Packaging', vi: 'Đóng gói', zh: '包装' })[locale] }}</li>
        <li>{{ ({ en: 'Warehousing', vi: 'Kho vận', zh: '仓储' })[locale] }}</li>
        <li>{{ ({ en: 'Logistics', vi: 'Logistics', zh: '物流' })[locale] }}</li>
        <li>{{ ({ en: 'Ports', vi: 'Cảng', zh: '港口' })[locale] }}</li>
        <li>{{ ({ en: 'Distribution', vi: 'Phân phối', zh: '分销' })[locale] }}</li>
      </ol>
    </div>

    {% set ecoMapVariant = "ink" %}
    {% set ecoMapShowHead = false %}
    {% set ecoMapId = "about-eco" %}
    {% include "partials/ecosystem-map.njk" %}
  </div>
</section>
{% endif %}

<section class="chapter chapter--light about-section" id="vision" data-page-panel="vision" data-chapter="03" data-label-en="PURPOSE" data-label-zh="使命" data-label-vi="ĐỊNH HƯỚNG">
  <div class="container about-vision">
    <header class="chapter__head about-section__head">
      <span class="chapter__num reveal">03</span>
      <p class="eyebrow reveal">
        {{ ({ en: 'Direction', vi: 'Định hướng', zh: '方向' })[locale] }}
      </p>
      <h2 class="chapter__title chapter__title--sm">
        {% if locale == 'en' %}
          <span class="line-mask"><span class="line">Where we aim.</span></span>
          <span class="line-mask"><span class="line line--muted">How we operate.</span></span>
        {% elif locale == 'zh' %}
          <span class="line-mask"><span class="line">目标所向。</span></span>
          <span class="line-mask"><span class="line line--muted">运营之道。</span></span>
        {% else %}
          <span class="line-mask"><span class="line">Đích đến.</span></span>
          <span class="line-mask"><span class="line line--muted">Cách chúng tôi vận hành.</span></span>
        {% endif %}
      </h2>
      <p class="chapter__desc reveal" data-delay="150">
        {{ about.valuesLead[locale] }}
      </p>
    </header>

    <div class="about-vmv">
      <article class="about-vmv__block about-vmv__block--vision reveal">
        <p class="about-vmv__label">
          {{ ({ en: 'Vision', vi: 'Tầm nhìn', zh: '愿景' })[locale] }}
        </p>
        <h3 class="about-vmv__title">
          {{ about.vision[locale] }}
        </h3>
      </article>
      <div class="about-vmv__pair">
        <article class="about-vmv__block about-vmv__block--mission reveal" data-delay="80">
          <p class="about-vmv__label">
            {{ ({ en: 'Mission', vi: 'Sứ mệnh', zh: '使命' })[locale] }}
          </p>
          <p class="about-vmv__body">
            {{ about.mission[locale] }}
          </p>
        </article>
        <article class="about-vmv__block about-vmv__block--values reveal" data-delay="160">
          <p class="about-vmv__label">
            {{ ({ en: 'Core values', vi: 'Giá trị cốt lõi', zh: '核心价值' })[locale] }}
          </p>
          <p class="about-vmv__values">
            {{ about.values[locale] }}
          </p>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="chapter chapter--light about-section" id="leadership" data-page-panel="leadership" data-chapter="04" data-label-en="LEADERSHIP" data-label-zh="领导团队" data-label-vi="LÃNH ĐẠO">
  <div class="container">
    <header class="chapter__head about-leader__head about-section__head">
      <span class="chapter__num reveal">04</span>
      <p class="eyebrow reveal">
        {{ ({ en: 'Leadership', vi: 'Lãnh đạo', zh: '领导团队' })[locale] }}
      </p>
      <h2 class="chapter__title chapter__title--sm">
        {% if locale == 'en' %}
          <span class="line-mask"><span class="line">Leadership that</span></span>
          <span class="line-mask"><span class="line line--muted">steers the Group.</span></span>
        {% elif locale == 'zh' %}
          <span class="line-mask"><span class="line">以领导力</span></span>
          <span class="line-mask"><span class="line line--muted">掌舵集团。</span></span>
        {% else %}
          <span class="line-mask"><span class="line">Ban lãnh đạo</span></span>
          <span class="line-mask"><span class="line line--muted">định hướng Tập đoàn.</span></span>
        {% endif %}
      </h2>
      <p class="chapter__desc reveal" data-delay="150">
        {{ ({ en: 'Executives across the Group set strategy and operating standards — open the leadership page for the full roster and profiles.', vi: 'Đội ngũ lãnh đạo định hướng chiến lược và chuẩn vận hành — xem danh sách và hồ sơ đầy đủ trên trang Ban lãnh đạo.', zh: '高管团队定调战略与运营标准——完整名录与简介请前往领导团队页。' })[locale] }}
      </p>
      <div class="reveal page-actions page-actions--tight" data-delay="220">
        <a class="btn btn--dark" href="{{ '/about/leadership/'  | localeUrl(locale) | url }}">
          <span class="btn__dot"></span>
          {{ ({ en: 'View detailed profiles', vi: 'Xem hồ sơ chi tiết', zh: '查看详细简介' })[locale] }}
        </a>
      </div>
    </header>

    {% include "partials/leadership-teaser.njk" %}
  </div>
</section>

<section class="about-close" aria-label="Next steps">
  <div class="container about-close__inner">
    <p class="about-close__lead reveal">
      {{ ({ en: 'Ready to explore the ecosystem or start a partnership?', vi: 'Sẵn sàng khám phá hệ sinh thái hoặc bắt đầu hợp tác?', zh: '准备探索生态体系或开启合作？' })[locale] }}
    </p>
    <div class="page-actions reveal" data-delay="100">
      <a class="btn btn--dark" href="{{ '/companies/'  | localeUrl(locale) | url }}">
        <span class="btn__dot"></span>
        {{ ({ en: 'Explore the ecosystem', vi: 'Khám phá hệ sinh thái', zh: '探索生态系统' })[locale] }}
      </a>
      <a class="btn btn--ghost" href="{{ '/contact/?type=partner'  | localeUrl(locale) | url }}">
        {{ ({ en: 'Partner with us', vi: 'Liên hệ hợp tác', zh: '联系合作' })[locale] }}
      </a>
    </div>
  </div>
</section>
