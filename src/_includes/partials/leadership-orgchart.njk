{#
  Organizational chart — rows from band flags (isChairman / isGroupSupport / isMemberDirector).
  Note: loop var must NOT be named `tier` — Nunjucks resolves person.tier as person[tier].
#}
<div class="orgchart reveal">
  <header class="orgchart__head">
    <p class="eyebrow">
      {{ ({ en: 'Organizational chart', vi: 'Sơ đồ tổ chức', zh: '组织架构' })[locale] }}
    </p>
    <p class="orgchart__count">
      {% if locale == 'en' %}{{ leadership | length }} executives across the Group and member units.{% elif locale == 'zh' %}集团及成员企业共 {{ leadership | length }} 位高管。{% else %}{{ leadership | length }} lãnh đạo tại Tập đoàn và các đơn vị thành viên.{% endif %}
    </p>
  </header>

  {% for level in [1, 2, 3] %}
  <ul class="orgchart__row orgchart__row--t{{ level }}" aria-label="Level {{ level }}">
    {% for person in leadership %}
      {% set inRow = (level == 1 and person.isChairman) or (level == 2 and person.isGroupSupport) or (level == 3 and person.isMemberDirector) %}
      {% if inRow %}
      <li>
        <a class="orgchart__card{% if level == 1 %} orgchart__card--apex{% endif %}" href="{{ ('/about/leadership/' + person.id + '/') | localeUrl(locale) | url }}">
          <div class="orgchart__media">
            <img src="{{ person.image | url }}" alt="{{ person.name.en }}" loading="{% if level == 1 %}eager{% else %}lazy{% endif %}" width="900" height="1200">
          </div>
          <span class="orgchart__name">
            {{ person.name[locale] }}
          </span>
          <span class="orgchart__role">
            {{ person.role[locale] }}
          </span>
        </a>
      </li>
      {% endif %}
    {% endfor %}
  </ul>
  {% endfor %}
</div>
