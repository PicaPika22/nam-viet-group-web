<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__grid">
      <div class="footer__brand-col">
        <a href="{{ '/' | url }}" class="footer__brand" aria-label="Nam Viet Group">
          <img class="footer__logo" src="{{ '/assets/img/logo-light-160.png' | url }}" alt="" width="62" height="62">
          <span class="footer__brand-rule" aria-hidden="true"></span>
          <span class="footer__brand-name">NAM VIỆT<span class="footer__brand-sub">GROUP</span></span>
        </a>
        <p class="footer__legal-name">
          <span class="lang en">{{ site.legalName.en }}</span>
          <span class="lang vi">{{ site.legalName.vi }}</span>
          <span class="lang zh">{{ site.legalName.zh }}</span>
        </p>
        <div class="footer__facts">
          <p>
            <strong>
              <span class="lang en">{{ i18n.en.headOffice }}</span>
              <span class="lang vi">{{ i18n.vi.headOffice }}</span>
              <span class="lang zh">{{ i18n.zh.headOffice }}</span>
            </strong>
            <span class="lang en">{{ site.address.en }}</span>
            <span class="lang vi">{{ site.address.vi }}</span>
            <span class="lang zh">{{ site.address.zh }}</span>
          </p>
          <p><strong>Tel:</strong> <a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a></p>
          <p><strong>Email:</strong> <a href="mailto:{{ site.emailPartner }}">{{ site.emailPartner }}</a></p>
          {% if site.taxId %}
          <p>
            <strong>
              <span class="lang en">{{ i18n.en.taxIdLabel }}</span>
              <span class="lang vi">{{ i18n.vi.taxIdLabel }}</span>
              <span class="lang zh">{{ i18n.zh.taxIdLabel }}</span>
            </strong>
            {{ site.taxId }}
          </p>
          {% endif %}
        </div>
      </div>
      {% for col in nav.footerColumns %}
      <nav class="footer__col" aria-labelledby="footerCol-{{ loop.index }}">
        <p class="footer__heading" id="footerCol-{{ loop.index }}">
          <span class="lang en">{{ col.en }}</span>
          <span class="lang vi">{{ col.vi }}</span>
          <span class="lang zh">{{ col.zh }}</span>
        </p>
        <ul class="footer__list">
          {% for item in col.links %}
          <li>
            <a href="{{ item.href | url }}">
              <span class="lang en">{{ item.en }}</span>
              <span class="lang vi">{{ item.vi }}</span>
              <span class="lang zh">{{ item.zh }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </nav>
      {% endfor %}
    </div>
    <div class="footer__bar">
      <p class="footer__copy">© 2026 Nam Viet Group.
        <span class="lang en">All rights reserved.</span>
        <span class="lang vi">Bảo lưu mọi quyền.</span>
        <span class="lang zh">保留所有权利。</span>
      </p>
      <nav class="footer__legal" aria-labelledby="footerLegalLabel">
        <span id="footerLegalLabel" class="visually-hidden">
          <span class="lang en">{{ i18n.en.legalEyebrow }}</span>
          <span class="lang vi">{{ i18n.vi.legalEyebrow }}</span>
          <span class="lang zh">{{ i18n.zh.legalEyebrow }}</span>
        </span>
        {% for item in nav.footerLegal %}
        <a href="{{ item.href | url }}">
          <span class="lang en">{{ item.en }}</span>
          <span class="lang vi">{{ item.vi }}</span>
          <span class="lang zh">{{ item.zh }}</span>
        </a>
        {% endfor %}
      </nav>
    </div>
  </div>
</footer>

<aside class="float-chat" aria-labelledby="floatChatLabel">
  <span id="floatChatLabel" class="visually-hidden">
    <span class="lang en">{{ i18n.en.quickContact }}</span>
    <span class="lang vi">{{ i18n.vi.quickContact }}</span>
    <span class="lang zh">{{ i18n.zh.quickContact }}</span>
  </span>
  <a class="float-chat__btn float-chat__btn--phone" href="tel:{{ site.phoneTel }}">
    <span class="visually-hidden">
      <span class="lang en">{{ i18n.en.callPhone }} {{ site.phone }}</span>
      <span class="lang vi">{{ i18n.vi.callPhone }} {{ site.phone }}</span>
      <span class="lang zh">{{ i18n.zh.callPhone }} {{ site.phone }}</span>
    </span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.5 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
  </a>
  {% if site.zalo %}
  <a class="float-chat__btn float-chat__btn--zalo" href="https://zalo.me/{{ site.zalo }}" target="_blank" rel="noopener noreferrer" title="Chat Zalo" aria-label="Chat Zalo">
    <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="currentColor" d="M24 4C12.95 4 4 12.42 4 22.8c0 5.7 2.9 10.8 7.45 14.2V44l7.05-3.85c1.75.5 3.6.75 5.5.75 11.05 0 20-8.42 20-18.8S35.05 4 24 4zm.7 25.9h-7.2l7.85-8.45c.55-.6.75-1.05.75-1.55 0-.9-.7-1.55-1.75-1.55h-8.7v2.55h6.85l-7.7 8.35c-.55.55-.8 1.05-.8 1.6 0 .9.7 1.55 1.8 1.55h8.95v-2.5zm10.15 0H27.5v-2.5h7.35v2.5z"/></svg>
  </a>
  {% endif %}
  {% if site.whatsapp %}
  <a class="float-chat__btn float-chat__btn--wa" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer" title="Chat WhatsApp" aria-label="Chat WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.5 14.3c-.3-.1-1.6-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.8-.8-1.4-1.7-1.6-2-.1-.3 0-.4.1-.5.1-.1.3-.3.4-.4.1-.1.2-.3.3-.4.1-.2 0-.3 0-.4 0-.1-.6-1.5-.8-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.4-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.8 4.4 3.8 1.5.6 2.1.7 2.9.6.4-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.2-.2-.5-.3zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.3c1.4.8 3.1 1.3 4.8 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3C4.1 15.1 3.6 13.6 3.6 12 3.6 7.4 7.4 3.6 12 3.6S20.4 7.4 20.4 12 16.6 20.2 12 20.2z"/></svg>
  </a>
  {% endif %}
</aside>

<div class="cookie-bar" id="cookieBar" hidden role="dialog" aria-labelledby="cookieBarTitle" aria-live="polite">
  <div class="cookie-bar__content">
    <p class="cookie-bar__title" id="cookieBarTitle">
      <span class="lang en">{{ i18n.en.cookieTitle }}</span>
      <span class="lang vi">{{ i18n.vi.cookieTitle }}</span>
      <span class="lang zh">{{ i18n.zh.cookieTitle }}</span>
    </p>
    <p class="cookie-bar__text">
      <span class="lang en">{{ i18n.en.cookieText }}</span>
      <span class="lang vi">{{ i18n.vi.cookieText }}</span>
      <span class="lang zh">{{ i18n.zh.cookieText }}</span>
      <a href="{{ '/cookies/' | url }}">
        <span class="lang en">{{ i18n.en.cookiePolicy }}</span>
        <span class="lang vi">{{ i18n.vi.cookiePolicy }}</span>
        <span class="lang zh">{{ i18n.zh.cookiePolicy }}</span>
      </a>
    </p>
  </div>
  <div class="cookie-bar__actions">
    <button type="button" class="cookie-bar__btn cookie-bar__btn--decline" id="cookieDecline">
      <span class="lang en">{{ i18n.en.cookieDecline }}</span>
      <span class="lang vi">{{ i18n.vi.cookieDecline }}</span>
      <span class="lang zh">{{ i18n.zh.cookieDecline }}</span>
    </button>
    <button type="button" class="cookie-bar__btn cookie-bar__btn--accept" id="cookieAccept">
      <span class="lang en">{{ i18n.en.cookieAccept }}</span>
      <span class="lang vi">{{ i18n.vi.cookieAccept }}</span>
      <span class="lang zh">{{ i18n.zh.cookieAccept }}</span>
    </button>
  </div>
</div>

{% if site.introVideo %}
<div class="video-modal" id="videoModal" hidden>
  <div class="video-modal__panel" role="dialog" aria-modal="true" aria-labelledby="videoModalTitle">
    <h2 id="videoModalTitle" class="visually-hidden">
      <span class="lang en">{{ i18n.en.introVideoTitle }}</span>
      <span class="lang vi">{{ i18n.vi.introVideoTitle }}</span>
      <span class="lang zh">{{ i18n.zh.introVideoTitle }}</span>
    </h2>
    <button type="button" class="video-modal__close" id="videoClose" aria-labelledby="videoCloseLabel">
      <span id="videoCloseLabel" class="visually-hidden">
        <span class="lang en">{{ i18n.en.closeVideo }}</span>
        <span class="lang vi">{{ i18n.vi.closeVideo }}</span>
        <span class="lang zh">{{ i18n.zh.closeVideo }}</span>
      </span>
      <span aria-hidden="true">×</span>
    </button>
    <div class="video-modal__frame">
      <iframe
        id="videoFrame"
        title="{{ i18n.en.introVideoTitle }}"
        data-source="{{ site.introVideo }}"
        data-title-en="{{ i18n.en.introVideoTitle }}"
        data-title-vi="{{ i18n.vi.introVideoTitle }}"
        data-title-zh="{{ i18n.zh.introVideoTitle }}"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</div>
{% endif %}
