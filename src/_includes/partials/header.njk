<header class="header{% if pageLayout == 'inner' or pageLayout == 'home' %} is-scrolled header--inner{% endif %}" id="header">
  <div class="header__inner">
    <a href="{{ '/' | localeUrl(locale) | url }}" class="header__logo" aria-label="Nam Viet Group">
      <span class="header__logo-mark">
        <img class="logo-img logo-img--light" src="{{ '/assets/img/logo-light.png' | url }}?v=seal-on" alt="">
        <img class="logo-img logo-img--dark" src="{{ '/assets/img/logo.png' | url }}?v=seal" alt="">
      </span>
      <span class="header__logo-rule" aria-hidden="true"></span>
      <span class="header__wordmark" translate="no">NAM VIỆT<span class="header__wordmark-sub">GROUP</span></span>
    </a>
    <nav class="header__nav" id="nav" aria-label="Primary">
      <div class="nav-mobile__head">
        <a href="{{ '/' | localeUrl(locale) | url }}" class="nav-mobile__brand">
          <img src="{{ '/assets/img/logo-light.png' | url }}?v=seal-on" alt="" width="40" height="28">
          <span translate="no">NAM VIỆT<span class="header__wordmark-sub">GROUP</span></span>
        </a>
        <button type="button" class="nav-mobile__close" id="navClose" aria-label="Close menu">
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <div class="nav-mobile__body">
      {% for item in nav.primary %}
      {% set onHome = (page.url | pageIdentity) == '/' %}
      {% set itemHref = (onHome and item.hrefHome) or item.hrefInner or item.href %}
      {% set hasChildren = item.children and item.children.length %}
      {% set hasMega = item.mega and item.mega.length %}
      {% if hasChildren or hasMega %}
      <div class="nav-item{% if hasMega %} has-mega{% else %} has-dropdown{% endif %}{% if item | navActive(page.url) %} is-current{% endif %}">
        <a
          href="{{ itemHref | localeUrl(locale) | url }}"
          class="nav-item__link{% if item | navActive(page.url) %} is-active{% endif %}"
          data-nav-id="{{ item.id }}"
          {% if item | navActive(page.url) %} aria-current="page"{% endif %}
          aria-haspopup="true"
          aria-expanded="false"
        >
          {{ item[locale] }}
          <svg class="nav-item__caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </a>

        {% if hasMega %}
        <div class="nav-mega">
          <div class="nav-mega__panel">
            <div class="nav-mega__grid">
              {% for col in item.mega %}
              <div class="nav-mega__col">
                <p class="nav-mega__head">
                  <span class="nav-mega__key">{{ ({ en: col.keyEn, vi: col.keyVi, zh: col.keyZh })[locale] }}</span>
                </p>
                <ul class="nav-mega__list">
                  {% for link in col.links %}
                  <li>
                    <a href="{{ link.href | localeUrl(locale) | url }}" class="nav-mega__link{% if (page.url | pageIdentity) == (link.href | pathOnly) %} is-active{% endif %}">
                      {{ link[locale] }}
                    </a>
                  </li>
                  {% endfor %}
                </ul>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
        {% else %}
        <div class="nav-dropdown" role="menu">
          {% for child in item.children %}
          <a
            href="{{ child.href | localeUrl(locale) | url }}"
            class="nav-dropdown__link{% if (not (child.href | hasHash)) and (page.url | pageIdentity) == (child.href | pathOnly) %} is-active{% endif %}"
            role="menuitem"
            data-nav-child="{{ child.id }}"
          >
            {{ child[locale] }}
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% else %}
      <a
        href="{{ itemHref | localeUrl(locale) | url }}"
        class="nav-item__link{% if item | navActive(page.url) %} is-active{% endif %}"
        data-nav-id="{{ item.id }}"
        {% if item | navActive(page.url) %} aria-current="page"{% endif %}
      >
        {{ item[locale] }}
      </a>
      {% endif %}
      {% endfor %}
      <span class="nav-indicator" aria-hidden="true"></span>
      </div>
      <div class="nav-mobile__foot">
        <a href="{{ '/contact/' | localeUrl(locale) | url }}" class="btn btn--small btn--solid nav-mobile__cta">
          {{ i18n[locale].contact }}
          <span aria-hidden="true">→</span>
        </a>
        <p class="nav-mobile__meta">
          <a href="mailto:partner@namvietgroup.vn">partner@namvietgroup.vn</a>
        </p>
      </div>
    </nav>
    <div class="nav-backdrop" id="navBackdrop" hidden></div>
    <div class="header__actions">
      <button type="button" class="search-toggle" id="searchToggle" aria-label="Search" aria-controls="siteSearch" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="1.6"/></svg>
      </button>
      <div class="lang-switch" id="langSwitch">
        <button
          type="button"
          class="lang-switch__toggle"
          id="langToggle"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="langMenu"
          aria-label="Language"
        >
          <span class="lang-flag lang-flag--{{ locale }}" data-lang-flag aria-hidden="true"></span>
          <span class="lang-switch__code" data-lang-code>{% if locale == 'zh' %}中文{% else %}{{ locale | upper }}{% endif %}</span>
          <svg class="lang-switch__caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
        <div class="lang-switch__menu" id="langMenu" role="listbox" aria-label="Language" hidden>
          <a href="{{ localeUrl(pageIdentity(page.url), 'vi') | url }}" lang="vi" role="option"{% if locale == 'vi' %} class="is-active"{% endif %} aria-label="Tiếng Việt">
            <span class="lang-flag lang-flag--vi" aria-hidden="true"></span>
            <span>VI</span>
          </a>
          <a href="{{ localeUrl(pageIdentity(page.url), 'en') | url }}" lang="en" role="option"{% if locale == 'en' %} class="is-active"{% endif %} aria-label="English">
            <span class="lang-flag lang-flag--en" aria-hidden="true"></span>
            <span>EN</span>
          </a>
          <a href="{{ localeUrl(pageIdentity(page.url), 'zh') | url }}" lang="zh-Hans" role="option"{% if locale == 'zh' %} class="is-active"{% endif %} aria-label="中文">
            <span class="lang-flag lang-flag--zh" aria-hidden="true"></span>
            <span>中文</span>
          </a>
        </div>
      </div>
      <a href="{{ '/contact/' | localeUrl(locale) | url }}" class="btn btn--small btn--solid header__cta">
        {{ i18n[locale].contact }}
        <span class="header__cta-arrow" aria-hidden="true">→</span>
      </a>
      <button type="button" class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="nav"><span></span><span></span></button>
    </div>
  </div>
</header>

<div class="site-search" id="siteSearch" hidden>
  <div class="site-search__panel" role="dialog" aria-modal="true" aria-label="Search">
    <label class="site-search__label" for="searchInput">
      {{ i18n[locale].search }}
    </label>
    <input type="search" id="searchInput" class="site-search__input" autocomplete="off"
      placeholder="{{ i18n[locale].searchPlaceholder }}"
      data-ph-en="{{ i18n.en.searchPlaceholder }}"
      data-ph-vi="{{ i18n.vi.searchPlaceholder }}"
      data-ph-zh="{{ i18n.zh.searchPlaceholder }}">
    <ul class="site-search__results" id="searchResults"></ul>
    <p class="site-search__empty" id="searchEmpty" hidden>
      {{ i18n[locale].searchNoResults }}
    </p>
  </div>
</div>
