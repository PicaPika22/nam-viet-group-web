{#
  Shared inner-page hero.
  Optional front matter / locals:
    eyebrow {en,vi,zh}
    heading {en,vi,zh}  OR title (string)
    lead {en,vi,zh}
    breadcrumb (string) — single trailing crumb
    breadcrumbHtml — raw HTML after Home (for article/product trails)
    heroTag — "section" (default) or "article"
    heroMeta — optional meta line (e.g. date)
#}
{% set tag = heroTag or "section" %}
<{{ tag }} class="inner-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ '/'  | localeUrl(locale) | url }}">
        {{ i18n[locale].breadcrumbHome }}
      </a>
      {% if breadcrumbHtml %}
      {{ breadcrumbHtml | safe }}
      {% elif breadcrumb %}
      <span aria-hidden="true">/</span>
      <span>{{ breadcrumb }}</span>
      {% endif %}
    </nav>
    {% if eyebrow %}
    <p class="eyebrow">
      {% if eyebrow.en %}
      {{ eyebrow[locale] }}
      {% else %}
      {{ eyebrow | safe }}
      {% endif %}
    </p>
    {% endif %}
    <h1 class="inner-hero__title">
      {% if heading %}
      {{ heading[locale] }}
      {% elif title.en %}
      {{ title[locale] }}
      {% else %}
      {{ title }}
      {% endif %}
    </h1>
    {% if lead %}
    <p class="inner-hero__lead">
      {{ lead[locale] }}
    </p>
    {% endif %}
    {% if heroMeta %}
    <p class="inner-hero__meta">{{ heroMeta }}</p>
    {% endif %}
  </div>
</{{ tag }}>
