{# Intro-video lightbox. Include once per page; pair with any [data-video-open] trigger. #}
<div class="video-modal" data-video-modal hidden>
  <div class="video-modal__backdrop" data-video-close></div>
  <div class="video-modal__dialog" role="dialog" aria-modal="true"
    aria-label="{{ ({ en: 'Nam Viet Group introduction video', vi: 'Video giới thiệu Tập đoàn Nam Việt', zh: '南越集团简介视频' })[locale] }}">
    <button type="button" class="video-modal__close" data-video-close
      aria-label="{{ ({ en: 'Close', vi: 'Đóng video', zh: '关闭' })[locale] }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <div class="video-modal__frame" data-video-frame></div>
  </div>
</div>
