<form class="contact-form" id="contactForm" action="{{ site.formEndpoint }}" method="POST">
  <input type="hidden" name="_subject" value="Nam Viet Group website inquiry">
  <input type="text" name="_gotcha" class="contact-form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">

  <div class="contact-form__grid">
    <label>
      {{ i18n[locale].formName }}
      <input type="text" name="name" required autocomplete="name">
    </label>
    <label>
      {{ i18n[locale].formEmail }}
      <input type="email" name="email" required autocomplete="email">
    </label>
    <label>
      {{ i18n[locale].formCompany }}
      <input type="text" name="company" autocomplete="organization">
    </label>
    <label>
      {{ i18n[locale].formPhone }}
      <input type="tel" name="phone" autocomplete="tel">
    </label>
    <label>
      {{ i18n[locale].formType }}
      <select name="inquiry_type" id="inquiryType">
        <option value="partner"
          data-label-en="{{ i18n.en.typePartner }}"
          data-label-vi="{{ i18n.vi.typePartner }}"
          data-label-zh="{{ i18n.zh.typePartner }}">{{ i18n[locale].typePartner }}</option>
        <option value="product"
          data-label-en="{{ i18n.en.typeProduct }}"
          data-label-vi="{{ i18n.vi.typeProduct }}"
          data-label-zh="{{ i18n.zh.typeProduct }}">{{ i18n[locale].typeProduct }}</option>
        <option value="logistics"
          data-label-en="{{ i18n.en.typeLogistics }}"
          data-label-vi="{{ i18n.vi.typeLogistics }}"
          data-label-zh="{{ i18n.zh.typeLogistics }}">{{ i18n[locale].typeLogistics }}</option>
        <option value="careers"
          data-label-en="{{ i18n.en.typeCareers }}"
          data-label-vi="{{ i18n.vi.typeCareers }}"
          data-label-zh="{{ i18n.zh.typeCareers }}">{{ i18n[locale].typeCareers }}</option>
        <option value="investor"
          data-label-en="{{ i18n.en.typeInvestor }}"
          data-label-vi="{{ i18n.vi.typeInvestor }}"
          data-label-zh="{{ i18n.zh.typeInvestor }}">{{ i18n[locale].typeInvestor }}</option>
        <option value="other"
          data-label-en="{{ i18n.en.typeOther }}"
          data-label-vi="{{ i18n.vi.typeOther }}"
          data-label-zh="{{ i18n.zh.typeOther }}">{{ i18n[locale].typeOther }}</option>
      </select>
    </label>
    <label>
      {{ i18n[locale].formProduct }}
      <input type="text" name="product_code" id="productCode" value="{{ productCode or '' }}" placeholder="NV007">
    </label>
  </div>
  <label class="contact-form__message">
    {{ i18n[locale].formMessage }}
    <textarea name="message" rows="5" required></textarea>
  </label>
  <p class="contact-form__note">
    {{ ({ en: 'By submitting, you agree to our', vi: 'Khi gửi form, bạn đồng ý với', zh: '提交即表示您同意我们的' })[locale] }}
    <a href="{{ '/privacy/'  | localeUrl(locale) | url }}">
      {{ ({ en: 'Privacy Policy', vi: 'Chính sách bảo mật', zh: '隐私政策' })[locale] }}
    </a>.
  </p>
  <button type="submit" class="btn btn--dark btn--big">
    <span class="btn__dot"></span>
    {{ i18n[locale].sendMessage }}
  </button>
  <p class="contact-form__status" id="formStatus" role="status" aria-live="polite" hidden></p>
</form>
