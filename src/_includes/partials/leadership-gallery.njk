{#
  Leadership gallery — quiet corporate authority.
  Bands (from person.band — NEVER guess from job title):
    chairman · group-support (Nụ / Phong / Miên ONLY) · member-director
  Classes: lgallery-* (isolated from legacy .leader-card).
#}
{% set chairman = null %}
{% for person in leadership %}
  {% if person.isChairman and not chairman %}{% set chairman = person %}{% endif %}
{% endfor %}

<section class="leader-gallery" aria-label="Leadership">
  <div class="leader-gallery__bg" aria-hidden="true">
    <img src="{{ '/assets/img/leadership-dark.jpg' | url }}" alt="" loading="eager" width="4096" height="2294" decoding="async">
    <div class="leader-gallery__veil"></div>
  </div>

  <div class="leader-gallery__inner">
    <header class="leader-gallery__head reveal">
      <p class="leader-gallery__eyebrow">
        {{ ({ en: 'Leadership', vi: 'Ban lãnh đạo', zh: '领导团队' })[locale] }}
      </p>
      <h1 class="leader-gallery__title">
        {{ ({ en: 'People who steer Nam Viet', vi: 'Những người định hướng Nam Việt', zh: '掌舵南越的领导团队' })[locale] }}
      </h1>
      <p class="leader-gallery__meta">
        {{ ({ en: 'From the Chairman to Group support and directors of member companies — one team guiding Nam Viet’s reach.', vi: 'Từ Chủ tịch đến đội ngũ hỗ trợ cấp Tập đoàn và giám đốc các công ty thành viên — cùng dẫn dắt Nam Việt vươn ra thế giới.', zh: '从集团主席到集团支持团队与成员企业负责人——共同引领南越走向世界。' })[locale] }}
      </p>
    </header>

    <nav class="leader-gallery__jump" aria-label="Leadership sections">
      <a href="#leadership-chairman">
        {{ ({ en: 'Chairman', vi: 'Chủ tịch', zh: '主席' })[locale] }}
      </a>
      <a href="#leadership-office">
        {{ ({ en: 'Group support', vi: 'Hỗ trợ Tập đoàn', zh: '集团支持' })[locale] }}
      </a>
      <a href="#leadership-companies">
        {{ ({ en: 'Member companies', vi: 'Công ty thành viên', zh: '成员企业' })[locale] }}
      </a>
    </nav>

    {% if chairman %}
    <section id="leadership-chairman" class="leader-gallery__band leader-gallery__band--chairman reveal">
      <h2 class="leader-gallery__band-title">
        {{ ({ en: 'Chairman of the Group', vi: 'Chủ tịch Tập đoàn', zh: '集团主席' })[locale] }}
      </h2>
      <article class="lgallery-feature">
        <a href="{{ ('/about/leadership/' + chairman.id + '/') | localeUrl(locale) | url }}" class="lgallery-feature__link">
          <div class="lgallery-feature__media">
            <img
              src="{{ chairman.image | url }}"
              alt="{{ chairman.name.en }} — {{ chairman.role.en }}"
              loading="eager"
              width="1800"
              height="2250"
              decoding="async"
              style="{% if chairman.objectPosition %}object-position: {{ chairman.objectPosition }};{% endif %}"
            >
          </div>
          <div class="lgallery-feature__copy">
            <p class="lgallery-feature__group">
              {{ ({ en: 'Group leadership', vi: 'Lãnh đạo Tập đoàn', zh: '集团领导' })[locale] }}
            </p>
            <h3 class="lgallery-feature__name">
              {{ chairman.name[locale] }}
            </h3>
            <p class="lgallery-feature__role">
              {{ chairman.role[locale] }}
            </p>
            <p class="lgallery-feature__bio">
              {% if locale == 'en' %}{{ chairman.bio.en | truncate(220) }}{% elif locale == 'zh' %}{{ chairman.bio.zh | truncate(180) }}{% else %}{{ chairman.bio.vi | truncate(220) }}{% endif %}
            </p>
            <span class="lgallery-feature__cue">
              {{ ({ en: 'View profile', vi: 'Xem hồ sơ', zh: '查看简介' })[locale] }}
            </span>
          </div>
        </a>
      </article>
    </section>
    {% endif %}

    <section id="leadership-office" class="leader-gallery__band reveal">
      <h2 class="leader-gallery__band-title leader-gallery__band-title--sticky">
        {{ ({ en: 'Group support', vi: 'Hỗ trợ cấp Tập đoàn', zh: '集团支持团队' })[locale] }}
      </h2>
      <p class="leader-gallery__band-lead">
        {{ ({ en: 'Deputy General Director, Chief Accountant, and Assistant to the General Director — the core support around Group leadership.', vi: 'Phó Tổng giám đốc, Kế toán trưởng và Trợ lý Tổng giám đốc — đội ngũ hỗ trợ cốt lõi bên cạnh lãnh đạo Tập đoàn.', zh: '副总经理、总会计师与总经理助理——围绕集团领导的核心支持团队。' })[locale] }}
      </p>
      <div class="leader-gallery__grid leader-gallery__grid--office">
        {% for person in leadership %}
          {% if person.isGroupSupport %}
          <article class="lgallery-card">
            <a href="{{ ('/about/leadership/' + person.id + '/') | localeUrl(locale) | url }}" class="lgallery-card__link">
              <div class="lgallery-card__media">
                <img
                  src="{{ person.image | url }}"
                  alt="{{ person.name.en }} — {{ person.role.en }}"
                  loading="lazy"
                  width="1800"
                  height="2250"
                  decoding="async"
                  style="{% if person.objectPosition %}object-position: {{ person.objectPosition }};{% endif %}"
                >
              </div>
              <div class="lgallery-card__info">
                <p class="lgallery-card__group">
                  {{ ({ en: 'Group support', vi: 'Hỗ trợ Tập đoàn', zh: '集团支持' })[locale] }}
                </p>
                <h3 class="lgallery-card__name">
                  {{ person.name[locale] }}
                </h3>
                <p class="lgallery-card__role">
                  {{ person.role[locale] }}
                </p>
                <span class="lgallery-card__cue">
                  {{ ({ en: 'View profile', vi: 'Xem hồ sơ', zh: '查看简介' })[locale] }}
                </span>
              </div>
            </a>
          </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <section id="leadership-companies" class="leader-gallery__band reveal">
      <h2 class="leader-gallery__band-title leader-gallery__band-title--sticky">
        {{ ({ en: 'Directors of member companies', vi: 'Giám đốc công ty thành viên', zh: '成员企业负责人' })[locale] }}
      </h2>
      <p class="leader-gallery__band-lead">
        {{ ({ en: 'Directors who run member companies across feed, trade, logistics, hospitality and rural development.', vi: 'Giám đốc điều hành các công ty thành viên — thức ăn, thương mại, logistics, du lịch và phát triển nông thôn.', zh: '执掌成员企业的负责人——覆盖饲料、贸易、物流、旅游与农村发展。' })[locale] }}
      </p>
      <div class="leader-gallery__grid leader-gallery__grid--companies">
        {% for person in leadership %}
          {% if person.isMemberDirector %}
          <article class="lgallery-card">
            <a href="{{ ('/about/leadership/' + person.id + '/') | localeUrl(locale) | url }}" class="lgallery-card__link">
              <div class="lgallery-card__media">
                <img
                  src="{{ person.image | url }}"
                  alt="{{ person.name.en }} — {{ person.role.en }}"
                  loading="lazy"
                  width="1800"
                  height="2250"
                  decoding="async"
                  style="{% if person.objectPosition %}object-position: {{ person.objectPosition }};{% endif %}"
                >
              </div>
              <div class="lgallery-card__info">
                <p class="lgallery-card__group">
                  {{ ({ en: 'Member company', vi: 'Công ty thành viên', zh: '成员企业' })[locale] }}
                </p>
                <h3 class="lgallery-card__name">
                  {{ person.name[locale] }}
                </h3>
                <p class="lgallery-card__role">
                  {{ person.role[locale] }}
                </p>
                <span class="lgallery-card__cue">
                  {{ ({ en: 'View profile', vi: 'Xem hồ sơ', zh: '查看简介' })[locale] }}
                </span>
              </div>
            </a>
          </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  </div>
</section>
