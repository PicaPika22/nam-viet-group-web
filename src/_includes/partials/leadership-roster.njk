{#
  Leadership roster — equal cards for every executive.
  Optional: rosterCompact (bool)
#}
<div class="leader-roster__head reveal">
  <p class="eyebrow">
    {{ ({ en: 'Group executives', vi: 'Lãnh đạo Tập đoàn', zh: '集团高管' })[locale] }}
  </p>
  <p class="leader-roster__count">
    {% if locale == 'en' %}{{ leadership | length }} executives across Group companies and member units — each profile below.{% elif locale == 'zh' %}集团及成员企业共 {{ leadership | length }} 位高管——以下均为完整履历入口。{% else %}{{ leadership | length }} lãnh đạo tại các công ty và đơn vị thành viên — xem đầy đủ hồ sơ bên dưới.{% endif %}
  </p>
</div>

<ul class="leader-grid{% if rosterCompact %} leader-grid--compact{% endif %}">
  {% for person in leadership %}
  <li class="reveal" data-delay="{{ (loop.index0 % 4) * 80 }}">
    <a class="leader-card" href="{{ ('/about/leadership/' + person.id + '/') | localeUrl(locale) | url }}">
      <div class="leader-card__media">
        <img src="{{ person.image | url }}" alt="{{ person.name.en }}" loading="lazy" width="900" height="1200">
        <span class="leader-card__no" aria-hidden="true">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
      </div>
      <span class="leader-card__name">
        {{ person.name[locale] }}
      </span>
      <span class="leader-card__role">
        {{ person.role[locale] }}
      </span>
      <span class="leader-card__more">
        {{ ({ en: 'Executive biography', vi: 'Tiểu sử lãnh đạo', zh: '高管履历' })[locale] }}
        <span aria-hidden="true">→</span>
      </span>
    </a>
  </li>
  {% endfor %}
</ul>
