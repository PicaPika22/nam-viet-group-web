{# Shared locale helpers — one copy per document #}

{% macro text(obj, tag="span", className="") -%}
{%- if obj -%}
<{{ tag }}{% if className %} class="{{ className }}"{% endif %}>{{ obj[locale] }}</{{ tag }}>
{%- endif -%}
{%- endmacro %}

{% macro inline(obj) -%}
{%- if obj -%}
{{ obj[locale] }}
{%- endif -%}
{%- endmacro %}

{% macro rich(obj) -%}
{%- if obj -%}
<div class="i18n-rich">{{ obj[locale] | md | safe }}</div>
{%- endif -%}
{%- endmacro %}
