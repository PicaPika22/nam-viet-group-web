{# Shared "Watch video" button — opens partials/video-modal.njk. Pass extra classes for tone (btn--light / btn--dark …). #}
{% macro videoButton(videoId, className="btn--outline btn--dark", ariaLabel="", attrs="") -%}
<button type="button" class="btn btn--play {{ className }}" data-video-open data-video-id="{{ videoId }}"{% if ariaLabel %} aria-label="{{ ariaLabel }}"{% endif %}{% if not videoId %} hidden{% endif %} {{ attrs | safe }}>
  <span class="btn__play" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.29-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14z"/></svg>
  </span>
  {{ ({ en: 'Watch video', vi: 'Xem video', zh: '观看视频' })[locale] }}
</button>
{%- endmacro %}
