---
layout: layouts/base.njk
pageLayout: inner
ogType: article
---
{% from "macros/i18n.njk" import inline, rich with context %}
{% set heroTag = "article" %}
{% set heroMeta = date | isoDate %}
{% set eyebrow = category %}
{% set breadcrumbHtml %}
      <span aria-hidden="true">/</span>
      <a href="{{ '/news/'  | localeUrl(locale) | url }}">
        {{ i18n[locale].news }}
      </a>
      <span aria-hidden="true">/</span>
      <span>{{ date | isoDate }}</span>
{% endset %}
{% include "partials/inner-hero.njk" %}
{% if image %}
<div class="container article-media">
  <img src="{{ image | url }}" alt="" loading="lazy">
</div>
{% endif %}
<section class="inner-body">
  <div class="container prose article-body">
    {% if body and body[locale] %}
    {{ rich(body) }}
    {% else %}
    {{ content | safe }}
    {% endif %}
    {% if gallery %}
    <div class="article-gallery">
      {% for photo in gallery %}
      <figure class="article-gallery__item">
        <img src="{{ photo.src | url }}" alt="{{ photo.caption[locale] if photo.caption }}" loading="lazy">
        {% if photo.caption %}<figcaption>{{ photo.caption[locale] }}</figcaption>{% endif %}
      </figure>
      {% endfor %}
    </div>
    {% endif %}
    <p class="article-back">
      <a href="{{ '/news/'  | localeUrl(locale) | url }}">←
        {{ i18n[locale].backToNews }}
      </a>
    </p>
  </div>
</section>
