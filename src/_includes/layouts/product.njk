---
layout: layouts/base.njk
pageLayout: inner
---
{% set eyebrow %}
<span class="pcard__code" style="color:{{ color }}">{{ code }}</span>
{% endset %}
{% set lead = summary %}
{% set breadcrumbHtml %}
      <span aria-hidden="true">/</span>
      <a href="{{ '/products/'  | localeUrl(locale) | url }}">
        {{ i18n[locale].products }}
      </a>
      <span aria-hidden="true">/</span>
      <span>{{ code }}</span>
{% endset %}
{% include "partials/inner-hero.njk" %}
<section class="inner-body">
  <div class="container prose">
    <div class="product-detail">
      {% if image %}
      <div class="product-detail__media">
        <img src="{{ image | url }}" alt="{{ code }}" loading="lazy" width="900" height="1200">
      </div>
      {% endif %}
      <div class="product-detail__panel" style="--pc:{{ color }}">
        <h2>
          {{ ({ en: 'Key specifications', vi: 'Thông số chính', zh: '核心规格' })[locale] }}
        </h2>
        <ul class="checks">
          {% for s in specs %}
          <li><i></i>
            {{ s[locale] }}
          </li>
          {% endfor %}
        </ul>
        <div class="product-detail__actions page-actions">
          <a class="btn btn--solid" href="{{ ('/contact/?type=product&product=' + code) | localeUrl(locale) | url }}">
            {{ i18n[locale].inquire }}
          </a>
          <a class="btn btn--outline" href="{{ '/downloads/'  | localeUrl(locale) | url }}">
            {{ i18n[locale].download }}
          </a>
          <a class="btn btn--outline" href="{{ '/products/'  | localeUrl(locale) | url }}">
            {{ i18n[locale].backToProducts }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
