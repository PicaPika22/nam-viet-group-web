---
layout: layouts/base.njk
pageLayout: inner
showLoader: false
showRail: false
---
<section class="leadership-hero leadership-hero--compact">
  <div class="container">
    <nav class="breadcrumb leadership-hero__crumb" aria-label="Breadcrumb">
      <a href="{{ '/'  | localeUrl(locale) | url }}">
        {{ i18n[locale].breadcrumbHome }}
      </a>
      <span aria-hidden="true">/</span>
      <a href="{{ '/about/'  | localeUrl(locale) | url }}">
        {{ ({ en: 'About', vi: 'Giới thiệu', zh: '关于' })[locale] }}
      </a>
      <span aria-hidden="true">/</span>
      <span>
        {{ ({ en: 'Leadership', vi: 'Ban lãnh đạo', zh: '领导团队' })[locale] }}
      </span>
    </nav>
  </div>
</section>
<section class="inner-body leadership-body leadership-body--strip">
{{ content | safe }}
</section>
