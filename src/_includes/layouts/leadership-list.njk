---
layout: layouts/base.njk
pageLayout: inner
showLoader: false
showRail: false
---
<section class="leadership-hero leadership-hero--compact">
  <div class="container">
    <nav class="breadcrumb leadership-hero__crumb" aria-label="Breadcrumb">
      <a href="{{ '/' | url }}">
        <span class="lang en">{{ i18n.en.breadcrumbHome }}</span>
        <span class="lang vi">{{ i18n.vi.breadcrumbHome }}</span>
        <span class="lang zh">{{ i18n.zh.breadcrumbHome }}</span>
      </a>
      <span aria-hidden="true">/</span>
      <a href="{{ '/about/' | url }}">
        <span class="lang en">About</span>
        <span class="lang vi">Giới thiệu</span>
        <span class="lang zh">关于</span>
      </a>
      <span aria-hidden="true">/</span>
      <span>
        <span class="lang en">Leadership</span>
        <span class="lang vi">Ban lãnh đạo</span>
        <span class="lang zh">领导团队</span>
      </span>
    </nav>
  </div>
</section>
<section class="inner-body leadership-body leadership-body--strip">
{{ content | safe }}
</section>
