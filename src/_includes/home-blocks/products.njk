<section class="chapter chapter--cream" id="products" data-chapter="{{ section.displayNum }}" data-label-en="{{ section.content.en.chapterLabel }}" data-label-zh="{{ section.content.zh.chapterLabel }}" data-label-vi="{{ section.content.vi.chapterLabel }}">
  <div class="container">
    <header class="chapter__head chapter__head--center">
      <span class="chapter__num reveal">{{ section.displayNum }}</span>
      <p class="eyebrow reveal">{{ section.content[locale].eyebrow }}</p>
      <h2 class="chapter__title">
        <span class="line-mask"><span class="line">{{ section.content[locale].titleLine1 }}</span></span><span class="line-mask"><span class="line line--muted">{{ section.content[locale].titleLine2 }}</span></span>
      </h2>
      <p class="chapter__desc reveal" data-delay="200">{{ section.content[locale].lead }}</p>
    </header>
    <div class="products__grid">
      {% for item in section.items %}
      <a href="{{ item.href | localeUrl(locale) | url }}" class="pcard pcard--media reveal" data-delay="{{ loop.index0 * 80 }}" style="--pc:{% if loop.index == 1 %}#c62828{% elif loop.index == 2 %}#2e7d32{% elif loop.index == 3 %}#1565c0{% elif loop.index == 4 %}#0277bd{% else %}#558b2f{% endif %}">
        <span class="pcard__media"><img src="{{ section.images[item.id] | url }}" alt="{{ item.code }}" loading="lazy" width="400" height="560" decoding="async"></span>
        <span class="pcard__code">{{ item.code }}</span>
        <span class="pcard__name">{{ item.name[locale] }}</span>
        <span class="pcard__more">{{ ({ en: 'Learn more', vi: 'Xem thêm', zh: '了解更多' })[locale] }} →</span>
      </a>
      {% endfor %}
    </div>
    <div class="center reveal" data-delay="300"><a href="{{ section.cta.primary.href | localeUrl(locale) | url }}" class="btn btn--dark"><span class="btn__dot"></span>{{ section.content[locale].ctaPrimary }}</a></div>
  </div>
</section>
