<section class="chapter chapter--light" id="manufacturing" data-chapter="{{ section.displayNum }}" data-label-en="{{ section.content.en.chapterLabel }}" data-label-zh="{{ section.content.zh.chapterLabel }}" data-label-vi="{{ section.content.vi.chapterLabel }}">
  <div class="container">
    <header class="chapter__head">
      <span class="chapter__num reveal">{{ section.displayNum }}</span>
      <p class="eyebrow reveal">{{ section.content[locale].eyebrow }}</p>
      <h2 class="chapter__title">
        <span class="line-mask"><span class="line">{{ section.content[locale].titleLine1 }}</span></span><span class="line-mask"><span class="line line--muted">{{ section.content[locale].titleLine2 }}</span></span>
      </h2>
    </header>
    <div class="manu__grid">
      <div class="manu__body">
        <p class="lead reveal">{{ section.content[locale].lead }}</p>
        <ul class="checks">{% for item in section.items %}<li class="reveal" data-delay="{{ loop.index0 * 100 }}"><i></i>{{ item.label[locale] }}</li>{% endfor %}</ul>
        <div class="reveal" data-delay="350"><a href="{{ section.cta.primary.href | localeUrl(locale) | url }}" class="btn btn--dark"><span class="btn__dot"></span>{{ section.content[locale].ctaPrimary }}</a></div>
      </div>
      <div class="manu__media reveal-img" data-parallax-img><img src="{{ section.images.media | url }}" alt="Automated feed production line" loading="lazy"></div>
    </div>
    <div class="manu__stats">
      {% for stat in section.stats %}
      <div class="stat stat--boxed reveal" data-delay="{{ loop.index0 * 100 }}">
        <span class="stat__value{% if stat.count == null %} stat__value--text{% endif %}">{{ stat.value }}</span>
        <span class="stat__label">{{ stat.label[locale] }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
