<section class="chapter chapter--light" id="leadership" data-chapter="{{ section.displayNum }}" data-label-en="{{ section.content.en.chapterLabel }}" data-label-zh="{{ section.content.zh.chapterLabel }}" data-label-vi="{{ section.content.vi.chapterLabel }}">
  <div class="container"><div class="leader__grid">
    <div class="leader__body">
      <span class="chapter__num reveal">{{ section.displayNum }}</span>
      <p class="eyebrow reveal">{{ section.content[locale].eyebrow }}</p>
      <h2 class="chapter__title chapter__title--sm">
        <span class="line-mask"><span class="line">{{ section.content[locale].titleLine1 }}</span></span><span class="line-mask"><span class="line line--muted">{{ section.content[locale].titleLine2 }}</span></span>
      </h2>
      <p class="body-text reveal" data-delay="150">{{ section.content[locale].body }}</p>
      <div class="reveal page-actions page-actions--tight" data-delay="250"><a href="{{ section.cta.primary.href | localeUrl(locale) | url }}" class="btn btn--dark"><span class="btn__dot"></span>{{ section.content[locale].ctaPrimary }}</a></div>
    </div>
    <div class="leader__media reveal-img" data-parallax-img><img src="{{ section.images.media | url }}" alt="Nam Viet Group leadership team" loading="lazy"></div>
  </div></div>
</section>
