<section class="chapter chapter--light" id="about" data-chapter="{{ section.displayNum }}" data-label-en="{{ section.content.en.chapterLabel }}" data-label-zh="{{ section.content.zh.chapterLabel }}" data-label-vi="{{ section.content.vi.chapterLabel }}">
  <div class="container">
    <header class="chapter__head">
      <span class="chapter__num reveal">{{ section.displayNum }}</span>
      <p class="eyebrow reveal">{{ section.content[locale].eyebrow }}</p>
      <h2 class="chapter__title">
        <span class="line-mask"><span class="line">{{ section.content[locale].titleLine1 }}</span></span><span class="line-mask"><span class="line line--muted">{{ section.content[locale].titleLine2 }}</span></span>
      </h2>
    </header>
    <div class="about__grid">
      <button type="button" class="about__media reveal-img video-trigger" data-parallax-img data-video-open data-video-id="CTsPIRyZzAY"
        aria-label="{{ ({ en: 'Play the Nam Viet Group introduction video', vi: 'Phát video giới thiệu Tập đoàn Nam Việt', zh: '播放南越集团简介视频' })[locale] }}">
        <img src="{{ section.images.media | url }}" alt="Golden grain in farmer's hands" loading="lazy">
        <span class="video-trigger__scrim" aria-hidden="true"></span>
        <span class="video-trigger__cue">
          <span class="video-trigger__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.29-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14z"/></svg>
          </span>
          <span class="video-trigger__label">{{ ({ en: 'Watch our story', vi: 'Xem video giới thiệu', zh: '观看集团简介' })[locale] }}</span>
        </span>
      </button>
      <div class="about__body">
        <p class="lead reveal">{{ section.content[locale].lead }}</p>
        <p class="body-text reveal" data-delay="150">{{ section.content[locale].body }}</p>
        <div class="stats">
          {% for stat in section.stats %}
          <div class="stat reveal" data-delay="{{ loop.index0 * 100 }}">
            <span class="stat__value">{{ stat.value }}</span>
            <span class="stat__label">{{ stat.label[locale] }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  {% include "partials/video-modal.njk" %}
</section>
