<section class="chapter chapter--light" id="about" data-chapter="{{ section.displayNum }}" data-label-en="{{ section.content.en.chapterLabel }}" data-label-zh="{{ section.content.zh.chapterLabel }}" data-label-vi="{{ section.content.vi.chapterLabel }}">
  <div class="container">
    <header class="chapter__head">
      <span class="chapter__num reveal">{{ section.displayNum }}</span>
      <p class="eyebrow reveal"><span class="lang en">{{ section.content.en.eyebrow }}</span><span class="lang vi">{{ section.content.vi.eyebrow }}</span><span class="lang zh">{{ section.content.zh.eyebrow }}</span></p>
      <h2 class="chapter__title">
        <span class="lang en"><span class="line-mask"><span class="line">{{ section.content.en.titleLine1 }}</span></span><span class="line-mask"><span class="line line--muted">{{ section.content.en.titleLine2 }}</span></span></span>
        <span class="lang vi"><span class="line-mask"><span class="line">{{ section.content.vi.titleLine1 }}</span></span><span class="line-mask"><span class="line line--muted">{{ section.content.vi.titleLine2 }}</span></span></span>
        <span class="lang zh"><span class="line-mask"><span class="line">{{ section.content.zh.titleLine1 }}</span></span><span class="line-mask"><span class="line line--muted">{{ section.content.zh.titleLine2 }}</span></span></span>
      </h2>
    </header>
    <div class="about__grid">
      <div class="about__media reveal-img" data-parallax-img><img src="{{ section.images.media | url }}" alt="Golden grain in farmer's hands" loading="lazy"></div>
      <div class="about__body">
        <p class="lead reveal"><span class="lang en">{{ section.content.en.lead }}</span><span class="lang vi">{{ section.content.vi.lead }}</span><span class="lang zh">{{ section.content.zh.lead }}</span></p>
        <p class="body-text reveal" data-delay="150"><span class="lang en">{{ section.content.en.body }}</span><span class="lang vi">{{ section.content.vi.body }}</span><span class="lang zh">{{ section.content.zh.body }}</span></p>
        <div class="stats">
          {% for stat in section.stats %}
          <div class="stat reveal" data-delay="{{ loop.index0 * 100 }}">
            <span class="stat__value">{{ stat.value }}</span>
            <span class="stat__label"><span class="lang en">{{ stat.label.en }}</span><span class="lang vi">{{ stat.label.vi }}</span><span class="lang zh">{{ stat.label.zh }}</span></span>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
