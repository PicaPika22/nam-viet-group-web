<section class="chapter cta" id="contact" data-chapter="{{ section.displayNum }}" data-label-en="{{ section.content.en.chapterLabel }}" data-label-zh="{{ section.content.zh.chapterLabel }}" data-label-vi="{{ section.content.vi.chapterLabel }}">
  <div class="chapter__bg" data-parallax="0.15"><img src="{{ section.images.background | url }}" alt="" loading="lazy"><div class="chapter__bg-veil chapter__bg-veil--warm"></div></div>
  <div class="container cta__inner">
    <span class="chapter__num reveal">{{ section.displayNum }}</span>
    <h2 class="chapter__title chapter__title--center">
      <span class="line-mask"><span class="line">{{ section.content[locale].titleLine1 }}</span></span><span class="line-mask"><span class="line line--accent">{{ section.content[locale].titleLine2 }}</span></span>
    </h2>
    <p class="chapter__desc chapter__desc--center reveal" data-delay="200">{{ section.content[locale].lead }}</p>
    <div class="cta__actions reveal" data-delay="350">
      <a href="{{ section.cta.primary.href | localeUrl(locale) | url }}" class="btn btn--solid btn--big">{{ section.content[locale].ctaPrimary }}</a>
      <a href="{{ section.cta.secondary.href | localeUrl(locale) | url }}" class="btn btn--light btn--big">{{ section.content[locale].ctaSecondary }}</a>
    </div>
  </div>
</section>
