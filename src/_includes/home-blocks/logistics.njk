<section class="chapter chapter--dark" id="logistics" data-chapter="{{ section.displayNum }}" data-label-en="{{ section.content.en.chapterLabel }}" data-label-zh="{{ section.content.zh.chapterLabel }}" data-label-vi="{{ section.content.vi.chapterLabel }}">
  <div class="chapter__bg" data-parallax="0.15"><img src="{{ section.images.background | url }}" alt="" loading="lazy"><div class="chapter__bg-veil chapter__bg-veil--strong"></div></div>
  <div class="container">
    <header class="chapter__head">
      <span class="chapter__num reveal">{{ section.displayNum }}</span>
      <p class="eyebrow eyebrow--light reveal">{{ section.content[locale].eyebrow }}</p>
      <h2 class="chapter__title">
        <span class="line-mask"><span class="line">{{ section.content[locale].titleLine1 }}</span></span><span class="line-mask"><span class="line line--accent">{{ section.content[locale].titleLine2 }}</span></span>
      </h2>
      <p class="chapter__desc reveal" data-delay="200">{{ section.content[locale].lead }}</p>
    </header>
    <div class="logi__stats">
      {% for stat in section.stats %}
      <div class="stat stat--glass reveal" data-delay="{{ loop.index0 * 120 }}">
        <span class="stat__value">{{ stat.value }}</span>
        <span class="stat__label">{{ stat.label[locale] }}</span>
      </div>
      {% endfor %}
    </div>
    <div class="reveal" data-delay="300"><a href="{{ section.cta.primary.href | localeUrl(locale) | url }}" class="btn btn--light"><span class="btn__dot"></span>{{ section.content[locale].ctaPrimary }}</a></div>
  </div>
</section>
