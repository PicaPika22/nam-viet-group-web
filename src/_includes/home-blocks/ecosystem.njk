<section class="chapter chapter--dark" id="ecosystem" data-chapter="{{ section.displayNum }}" data-label-en="{{ section.content.en.chapterLabel }}" data-label-zh="{{ section.content.zh.chapterLabel }}" data-label-vi="{{ section.content.vi.chapterLabel }}">
  <div class="chapter__bg" data-parallax="0.15"><img src="{{ section.images.background | url }}" alt="" loading="lazy"><div class="chapter__bg-veil"></div></div>
  <div class="container">
    <header class="chapter__head">
      <span class="chapter__num reveal">{{ section.displayNum }}</span>
      <p class="eyebrow eyebrow--light reveal">{{ section.content[locale].eyebrow }}</p>
      <h2 class="chapter__title">
        <span class="line-mask"><span class="line">{{ section.content[locale].titleLine1 }}</span></span><span class="line-mask"><span class="line line--accent">{{ section.content[locale].titleLine2 }}</span></span>
      </h2>
      <p class="chapter__desc reveal" data-delay="200">{{ section.content[locale].lead }}</p>
    </header>

    {% set chain = ecosystem.chain if ecosystem else [] %}
    {% set sectors = ecosystem.sectors if ecosystem else [] %}
    {% if sectors | length %}
    <div class="eco-mill reveal" data-delay="80" data-eco-mill data-eco-default="feed">
      <div class="eco-mill__gates" role="tablist" aria-label="{{ ({ en: 'Ecosystem sectors', vi: 'Trụ cột hệ sinh thái', zh: '生态支柱' })[locale] }}">
        {% for sector in sectors %}
        <button
          type="button"
          class="eco-mill__gate{% if loop.first %} is-active{% endif %}"
          role="tab"
          id="eco-mill-gate-{{ sector.id }}"
          aria-controls="eco-mill-dock-{{ sector.id }}"
          aria-selected="{{ 'true' if loop.first else 'false' }}"
          tabindex="{{ 0 if loop.first else -1 }}"
          data-eco-gate="{{ sector.id }}"
          data-chain-steps="{{ sector.chainSteps | join(',') }}"
        >
          <span class="eco-mill__gate-key" aria-hidden="true">{{ sector.key[locale] }}</span>
          <span class="eco-mill__gate-label">{{ sector.title[locale] }}</span>
        </button>
        {% endfor %}
      </div>

      <div class="eco-mill__stage">
        <svg class="eco-mill__path" viewBox="0 0 800 4" preserveAspectRatio="none" aria-hidden="true" data-eco-path>
          <line class="eco-mill__path-bg" x1="0" y1="2" x2="800" y2="2" />
          {% for step in chain %}
          {% if not loop.first %}
          <line
            class="eco-mill__path-seg"
            data-eco-seg="{{ loop.index0 - 1 }}-{{ loop.index0 }}"
            x1="{{ (loop.index0 - 1) * (800 / (chain.length - 1)) }}" y1="2"
            x2="{{ loop.index0 * (800 / (chain.length - 1)) }}" y2="2"
          />
          {% endif %}
          {% endfor %}
        </svg>
        <ol class="eco-mill__stations" aria-hidden="true">
          {% for step in chain %}
          <li class="eco-mill__station" data-chain-step="{{ step.id }}">
            <span class="eco-mill__station-stamp">
              <span class="eco-mill__station-no">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
            </span>
            <span class="eco-mill__station-label">{{ step[locale] }}</span>
          </li>
          {% endfor %}
        </ol>
      </div>

      <div class="eco-mill__docks">
        {% for sector in sectors %}
        <ul
          class="eco-mill__dock{% if loop.first %} is-active{% endif %}"
          role="tabpanel"
          id="eco-mill-dock-{{ sector.id }}"
          aria-labelledby="eco-mill-gate-{{ sector.id }}"
          data-eco-dock="{{ sector.id }}"
          {% if not loop.first %}hidden{% endif %}
        >
          {% for co in sector.companies %}
          <li class="eco-mill__co">
            <a class="eco-mill__co-link" href="{{ ('/companies/' + co.id + '/') | localeUrl(locale) | url }}">
              <span class="eco-mill__co-short">{{ co.short[locale] }}</span>
              {% if co.year %}<span class="eco-mill__co-year">{{ co.year }}</span>{% endif %}
              {% if co.unit %}
              <span class="eco-mill__co-unit">
                {{ ({ en: 'Unit', vi: 'Đơn vị', zh: '单位' })[locale] }}
              </span>
              {% endif %}
              <span class="eco-mill__co-go" aria-hidden="true">→</span>
            </a>
          </li>
          {% endfor %}
        </ul>
        {% endfor %}
      </div>

      <p class="visually-hidden" aria-live="polite" data-eco-status></p>
    </div>
    {% endif %}

    <div class="reveal" data-delay="300"><a href="{{ section.cta.primary.href | localeUrl(locale) | url }}" class="btn btn--light"><span class="btn__dot"></span>{{ section.content[locale].ctaPrimary }}</a></div>
  </div>
</section>
