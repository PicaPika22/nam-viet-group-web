<section class="chapter chapter--cream" id="sustainability" data-chapter="{{ section.displayNum }}" data-label-en="{{ section.content.en.chapterLabel }}" data-label-zh="{{ section.content.zh.chapterLabel }}" data-label-vi="{{ section.content.vi.chapterLabel }}">
  <div class="container">
    <header class="chapter__head">
      <span class="chapter__num reveal">{{ section.displayNum }}</span>
      <p class="eyebrow reveal">{{ section.content[locale].eyebrow }}</p>
      <h2 class="chapter__title">
        <span class="line-mask"><span class="line">{{ section.content[locale].titleLine1 }}</span></span><span class="line-mask"><span class="line line--muted">{{ section.content[locale].titleLine2 }}</span></span>
      </h2>
    </header>
    <div class="esg__grid">
      <div class="esg__media reveal-img" data-parallax-img><img src="{{ section.images.media | url }}" alt="Young seedling in hands" loading="lazy"></div>
      <div class="esg__body">
        <p class="lead reveal">{{ section.content[locale].lead }}</p>
        {% if sustainability and sustainability.pillars %}
        <div class="pillars">
          {% for pillar in sustainability.pillars %}
          <article class="pillar reveal" data-delay="{{ loop.index0 * 120 }}">
            <span class="pillar__letter">{{ pillar.letter }}</span>
            <h3>{{ pillar.title[locale] }}</h3>
            <p>{{ pillar.teaser[locale] if pillar.teaser else pillar.lead[locale] }}</p>
          </article>
          {% endfor %}
        </div>
        {% endif %}
        <div class="reveal" data-delay="300"><a href="{{ section.cta.primary.href | localeUrl(locale) | url }}" class="btn btn--dark"><span class="btn__dot"></span>{{ section.content[locale].ctaPrimary }}</a></div>
      </div>
    </div>
  </div>
</section>
