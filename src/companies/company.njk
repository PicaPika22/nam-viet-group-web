---
pagination:
  data: companyLocales
  size: 1
  alias: render
permalink: "{{ localeUrl('/companies/' + render.item.id + '/', render.locale) }}"
layout: layouts/inner.njk
eleventyComputed:
  locale: "{{ render.locale }}"
---
{% set company = render.item %}
<div class="company-stage">
  <div class="company-stage__panel">
    <div class="company-stage__media">
      <img
        src="{{ company.sector.image | url }}"
        alt=""
        loading="lazy"
        decoding="async"
        width="960"
        height="640"
      >
      <div class="company-stage__veil" aria-hidden="true"></div>
      <div class="company-stage__media-copy">
        <p class="company-stage__sector-key" aria-hidden="true">
          {{ company.sector.key[locale] }}
        </p>
        <p class="company-stage__sector-title">
          {{ company.sector.title[locale] }}
        </p>
        {% if company.year %}
        <p class="company-stage__year">
          {% if locale == 'en' %}Since {{ company.year }}{% elif locale == 'zh' %}始于 {{ company.year }}{% else %}Từ {{ company.year }}{% endif %}
        </p>
        {% endif %}
        {% if company.unit %}
        <p class="company-stage__unit">
          {{ ({ en: 'Group unit', vi: 'Đơn vị tập đoàn', zh: '集团单位' })[locale] }}
        </p>
        {% endif %}
      </div>
    </div>

    <div class="company-stage__body">
      <p class="company-stage__short">
        {{ company.short[locale] }}
      </p>
      <p class="company-stage__blurb">
        {{ company.sector.blurb[locale] }}
      </p>

      {% if company.focuses and (company.focuses | length) %}
      <ol class="company-stage__focus">
        {% for item in company.focuses %}
        <li>
          <span class="company-stage__focus-num" aria-hidden="true">0{{ loop.index }}</span>
          <span>
            {{ item[locale] }}
          </span>
        </li>
        {% endfor %}
      </ol>
      {% endif %}

      <div class="company-stage__actions">
        <a class="btn btn--solid" href="{{ '/contact/'  | localeUrl(locale) | url }}">
          {{ i18n[locale].contact }}
        </a>
        <a class="btn btn--outline btn--dark" href="{{ ('/companies/#' + company.sector.id) | localeUrl(locale) | url }}">
          {{ ({ en: 'Back to map', vi: 'Về bản đồ', zh: '返回地图' })[locale] }}
        </a>
      </div>
    </div>
  </div>

  {% if company.siblings and (company.siblings | length) %}
  <section class="company-stage__related">
    <h2>
      {{ ({ en: 'Also in this sector', vi: 'Cùng ngành trong tập đoàn', zh: '同板块成员' })[locale] }}
    </h2>
    <ul class="company-stage__sibs">
      {% for sib in company.siblings %}
      <li>
        <a href="{{ sib.url | localeUrl(locale) | url }}">
          {{ sib.short[locale] }}
          <span aria-hidden="true">→</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</div>
