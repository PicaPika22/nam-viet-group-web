---
pagination:
  data: leadershipPersonLocales
  size: 1
  alias: render
permalink: "{{ localeUrl('/about/leadership/' + render.item.id + '/', render.locale) }}"
layout: layouts/leader.njk
eleventyComputed:
  locale: "{{ render.locale }}"
  title: "{{ render.item.name[render.locale] }}"
---
{% set person = render.item %}
<article class="leader-stage">
  <div class="leader-stage__top">
    <div class="container">
      <nav class="breadcrumb leader-stage__crumb" aria-label="Breadcrumb">
        <a href="{{ '/'  | localeUrl(locale) | url }}">
          {{ i18n[locale].breadcrumbHome }}
        </a>
        <span aria-hidden="true">/</span>
        <a href="{{ '/about/leadership/'  | localeUrl(locale) | url }}">
          {{ ({ en: 'Leadership', vi: 'Ban lãnh đạo', zh: '领导团队' })[locale] }}
        </a>
        <span aria-hidden="true">/</span>
        <span>
          {{ person.name[locale] }}
        </span>
      </nav>
    </div>
  </div>

  <div class="leader-stage__panel">
    <div class="leader-stage__media">
      <img
        src="{{ person.image | url }}"
        alt="{{ person.name.en }}"
        width="1800"
        height="2250"
        loading="eager"
        decoding="async"
      >
      <div class="leader-stage__veil" aria-hidden="true"></div>
      <div class="leader-stage__media-copy">
        <p class="eyebrow eyebrow--light">
          {{ person.role[locale] }}
        </p>
        <h1 class="leader-stage__name">
          {{ person.name[locale] }}
        </h1>
      </div>
    </div>

    <div class="leader-stage__body">
      <p class="leader-stage__kicker">
        {{ ({ en: 'Executive Biography', vi: 'Tiểu sử lãnh đạo', zh: '高管履历' })[locale] }}
      </p>
      {% if person.bio %}
      <blockquote class="leader-stage__quote">
        <p>
          {{ person.bio[locale] }}
        </p>
      </blockquote>
      {% endif %}
      <div class="page-actions page-actions--tight">
        <a class="btn btn--solid" href="{{ '/contact/'  | localeUrl(locale) | url }}">
          <span class="btn__dot"></span>
          {{ i18n[locale].contact }}
        </a>
        <a class="btn btn--outline btn--dark" href="{{ '/about/leadership/'  | localeUrl(locale) | url }}">
          {{ ({ en: 'Full leadership roster', vi: 'Toàn bộ ban lãnh đạo', zh: '完整领导名录' })[locale] }}
        </a>
      </div>
    </div>
  </div>

  <section class="leader-stage__more" aria-labelledby="more-leaders">
    <div class="container">
      <header class="leader-stage__more-head">
        <p class="eyebrow">
          {{ ({ en: 'Continue', vi: 'Tiếp tục', zh: '继续浏览' })[locale] }}
        </p>
        <h2 id="more-leaders">
          {{ ({ en: 'Other Group executives', vi: 'Các lãnh đạo khác trong Tập đoàn', zh: '集团其他高管' })[locale] }}
        </h2>
      </header>
      <ul class="leader-grid leader-grid--strip">
        {% for p in leadership %}
        {% if p.id != person.id %}
        <li>
          <a class="leader-card" href="{{ ('/about/leadership/' + p.id + '/') | localeUrl(locale) | url }}">
            <div class="leader-card__media">
              <img src="{{ p.image | url }}" alt="" loading="lazy" width="1800" height="2250">
            </div>
            <span class="leader-card__name">
              {{ p.name[locale] }}
            </span>
            <span class="leader-card__role">
              {{ p.role[locale] }}
            </span>
            <span class="leader-card__more">
              {{ ({ en: 'Biography', vi: 'Tiểu sử', zh: '履历' })[locale] }}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
        {% endif %}
        {% endfor %}
      </ul>
    </div>
  </section>
</article>
