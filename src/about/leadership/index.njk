---
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ localeUrl('/about/leadership/', locale) }}"
layout: layouts/base.njk
pageLayout: inner
showLoader: false
showRail: false
eleventyComputed:
  title: "Ban lãnh đạo"
---
<div class="leadership-page">
<section class="leadership-hero">
  <div class="container">
    <nav class="breadcrumb leadership-hero__crumb" aria-label="Breadcrumb">
      <a href="{{ '/'  | localeUrl(locale) | url }}">
        {{ i18n[locale].breadcrumbHome }}
      </a>
      <span aria-hidden="true">/</span>
      <a href="{{ '/about/'  | localeUrl(locale) | url }}">
        {{ ({ en: 'About', vi: 'Giới thiệu', zh: '关于' })[locale] }}
      </a>
      <span aria-hidden="true">/</span>
      <span>
        {{ ({ en: 'Leadership', vi: 'Ban lãnh đạo', zh: '领导团队' })[locale] }}
      </span>
    </nav>
  </div>
</section>
<section class="leadership-body">
{% include "partials/leadership-gallery.njk" %}

<aside class="leadership-help reveal" aria-label="How to reach us">
  <h2 class="leadership-help__title">
    {{ ({ en: 'Looking for the right contact?', vi: 'Bạn cần liên hệ đúng bộ phận?', zh: '需要联系对应部门？' })[locale] }}
  </h2>
  <ul class="leadership-help__list" role="list">
    <li>
      <a href="{{ '/contact/'  | localeUrl(locale) | url }}">
        {{ ({ en: 'Partnerships', vi: 'Quan hệ đối tác', zh: '合作伙伴' })[locale] }}
      </a>
    </li>
    <li>
      <a href="mailto:partner@namvietgroup.vn">
        {{ ({ en: 'Media', vi: 'Truyền thông', zh: '媒体联络' })[locale] }}
      </a>
    </li>
    <li>
      <a href="{{ '/careers/'  | localeUrl(locale) | url }}">
        {{ ({ en: 'Careers', vi: 'Tuyển dụng', zh: '招聘' })[locale] }}
      </a>
    </li>
    <li>
      <a href="{{ '/about/'  | localeUrl(locale) | url }}">
        {{ ({ en: 'Company information', vi: 'Thông tin doanh nghiệp', zh: '企业信息' })[locale] }}
      </a>
    </li>
  </ul>
</aside>

<p class="page-actions page-actions--leadership reveal">
  <a class="btn btn--solid" href="{{ '/#milestones'  | localeUrl(locale) | url }}">
    <span class="btn__dot"></span>
    {{ ({ en: 'Explore our history', vi: 'Khám phá lịch sử phát triển', zh: '探索发展历程' })[locale] }}
  </a>
  <a class="btn btn--outline btn--light" href="{{ '/companies/'  | localeUrl(locale) | url }}">
    {{ ({ en: 'Nam Viet ecosystem', vi: 'Tìm hiểu hệ sinh thái Nam Việt', zh: '了解南越生态' })[locale] }}
  </a>
</p>
</section>
</div>
